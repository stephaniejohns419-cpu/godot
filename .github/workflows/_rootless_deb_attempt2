name: Build GoBreak Engine (Rootless DEB Package)

on:
  workflow_dispatch:
  push:
    branches: [ "main" ]

jobs:
  build-deb:
    runs-on: macos-latest
    
    steps:
      - name: Checkout Source Code
        uses: actions/checkout@v4

      - name: Set up Python & SCons
        uses: actions/setup-python@v5
        with:
          python-version: '3.x'

      - name: Install Dependencies
        run: |
          python -m pip install scons
          brew install dpkg

      - name: Compile GoBreak Engine Binary
        run: |
          # Compile the main iOS engine templates for rootless devices (iOS 15+)
          scons platform=ios target=template_release arch=arm64 ios_min_version=15.0 -j$(sysctl -n hw.logicalcpu)

      - name: Assemble Mobile Application Bundle
        run: |
          # 1. Create a clean staging wrapper matching a standard iOS App layout
          mkdir -p GoBreak.app
          
          # 2. Extract the default binary from Godot's output directory
          # Godot binaries match a string scheme like 'godot.ios.template_release.arm64'
          COMPILED_BIN=$(find bin/ -type f -name "godot.ios.*" | head -n 1)
          if [ -z "$COMPILED_BIN" ]; then
            echo "Error: Compiled engine binary not found in bin/!" && exit 1
          fi
          
          # Copy binary into the application container folder and rename it to match executable standards
          cp "$COMPILED_BIN" GoBreak.app/GoBreak
          chmod +x GoBreak.app/GoBreak

          # 3. Build a basic standalone Info.plist so iOS knows how to launch the binary
          cat <<EOF > GoBreak.app/Info.plist
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://apple.com">
          <plist version="1.0">
          <dict>
              <key>CFBundleDevelopmentRegion</key>
              <string>English</string>
              <key>CFBundleExecutable</key>
              <string>GoBreak</string>
              <key>CFBundleIdentifier</key>
              <string>com.yourname.gobreak</string>
              <key>CFBundleInfoDictionaryVersion</key>
              <string>6.0</string>
              <key>CFBundleName</key>
              <string>GoBreak</string>
              <key>CFBundlePackageType</key>
              <string>APPL</string>
              <key>CFBundleShortVersionString</key>
              <string>1.0.0</string>
              <key>CFBundleSignature</key>
              <string>????</string>
              <key>CFBundleVersion</key>
              <string>1.0.0</string>
              <key>LSRequiresIPhoneOS</key>
              <true/>
              <key>MinimumOSVersion</key>
              <string>15.0</string>
              <key>UIDeviceFamily</key>
              <array>
                  <integer>1</integer>
                  <integer>2</integer>
              </array>
          </dict>
          </plist>
          EOF

      - name: Create Ad-Hoc Entitlements File
        run: |
          cat <<EOF > entitlements.plist
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://apple.com">
          <plist version="1.0">
          <dict>
              <key>com.apple.security.cs.allow-jit</key>
              <true/>
              <key>com.apple.security.get-task-allow</key>
              <true/>
              <key>com.apple.private.security.no-sandbox</key>
              <true/>
          </dict>
          </plist>
          EOF

      - name: Pseudo-Sign App Bundle
        run: |
          # Apply rootless execution rights cleanly directly to the constructed local container folder
          echo "Signing GoBreak.app with custom rootless entitlements..."
          codesign --force --sign - --entitlements entitlements.plist GoBreak.app

      - name: Build Rootless Debian Package Structure
        run: |
          # 1. Structure the rootless framework environment layout
          mkdir -p deb_stage/DEBIAN
          mkdir -p deb_stage/var/jb/Applications
          
          # 2. Output package manager control metadata
          cat <<EOF > deb_stage/DEBIAN/control
          Package: com.yourname.gobreak
          Name: GoBreak Engine
          Version: 1.0.0
          Architecture: iphoneos-arm64
          Description: A custom Godot engine fork optimized natively for rootless jailbroken iOS.
          Maintainer: YourName <youremail@example.com>
          Author: YourName
          Section: Development
          Depends: firmware (>= 15.0)
          EOF

          # 3. Deploy our generated valid application bundle straight to the staging directory
          cp -r GoBreak.app deb_stage/var/jb/Applications/

      - name: Compile Staging Directory into DEB
        run: |
          # Compress everything to produce your final system file package
          dpkg-deb -Zxz --root-owner-group -b deb_stage com.yourname.gobreak_rootless.deb

      - name: Upload Finished Engine DEB
        uses: actions/upload-artifact@v4
        with:
          name: GoBreak-Rootless-DEB
          path: com.yourname.gobreak_rootless.deb
          retention-days: 7
